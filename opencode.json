{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode/nemotron-3.5-lightning-free",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "rm -rf /": "deny",
      "rm -rf ~": "deny",
      "git push*": "ask",
      "git commit*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/opencode/**": "allow",
      "~/.local/state/opencode-web-kit/**": "allow",
      "~/.cache/ms-playwright/**": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--cdp-endpoint",
        "http://localhost:9222"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.11.0",
        "--browserUrl",
        "http://localhost:9222"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@4.4.2"
      ],
      "enabled": true
    }
  },
  "experimental": {
    "mcp_timeout": 60000
  },
  "plugin": [
    "@dietrichgebert/ponytail"
  ]
}
